{
  "model": {
    "attention_type": "bmbuv",
    "vocab_size": 50304,
    "n_layer": 12,
    "n_head": 22,
    "n_kv_head": 2,
    "n_embd": 768,
    "head_dim": 64,
    "value_dim": 64,
    "intermediate_size": 2048,
    "latent_rank": 64,
    "factor_rank": 32,
    "block_size": 1024
  },
  "data": {
    "path": "data/fineweb-edu100B",
    "sequence_length": 1024,
    "validation_batches": 200
  },
  "training": {
    "micro_batch_size": 24,
    "gradient_accumulation_steps": 5,
    "max_steps": 100000,
    "warmup_steps": 2000,
    "learning_rate": 0.0006,
    "min_learning_rate": 0.00003,
    "weight_decay": 0.1,
    "beta1": 0.9,
    "beta2": 0.95,
    "grad_clip": 1.0,
    "bf16": true,
    "seed": 5000,
    "eval_interval": 1000,
    "log_interval": 10,
    "compile": true
  },
  "output_dir": "runs/fineweb_bmbuv_small"
}
